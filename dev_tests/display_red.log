    @pytest.mark.parametrize('source', ['notebook', 'generator'])
    def test_regularization_fields_share_color_mapping_and_readable_layout(source, figures, tmp_path):
        code = selected_cell(source, 6, 'def run_regularization')
        function = next(n for n in ast.parse(code).body if isinstance(n, ast.FunctionDef)
                        and n.name == 'run_regularization')
        # Execute the actual plotting block only: deliberately do not call training,
        # construct an optimizer, or replace the scientific predictions in a notebook.
        start = next(i for i, node in enumerate(function.body) if isinstance(node, ast.Assign)
                     and any(isinstance(t, ast.Tuple) and any(isinstance(v, ast.Name) and v.id == 'fig'
                             for v in t.elts) for t in node.targets))
        stop = next(i for i, node in enumerate(function.body) if isinstance(node, ast.Assign)
                    and any(isinstance(t, ast.Name) and t.id == 'physical_prediction' for t in node.targets))
        plotting = ast.Module(body=function.body[start:stop], type_ignores=[])
        tw = TravelingWaveHighFreq()
        data = tw.data.copy()
        xx, tt = np.meshgrid(np.linspace(0, 1, 200, endpoint=False), np.linspace(0, 100, 10, endpoint=False))
        test_xx, test_tt = np.meshgrid(np.linspace(-1, 1, 41), np.linspace(-1, 1, 41))
        train_pred = .02 + np.linspace(-1e-10, 1e-10, len(data))
        test_pred = .02 + 1e-10 * np.sin(test_xx) * np.cos(test_tt)
        originals = [v.copy() for v in (data, train_pred, test_pred)]
        scope = dict(np=np, plt=plt, OUT=tmp_path, train_data=data, train_pred=train_pred,
                     test_pred=test_pred, tt=tt, xx=xx, test_tt=test_tt, test_xx=test_xx, name='l2_0.01')
        exec(compile(plotting, '<notebook contour display>', 'exec'), scope)
        fig, axes = scope['fig'], scope['axs']
        contours = [next(c for c in ax.collections if isinstance(c, QuadContourSet)) for ax in axes]
        for contour in contours[1:]:
>           np.testing.assert_array_equal(contour.levels, contours[0].levels)


                   and any(isinstance(t,ast.Name) and t.id=='history' for t in node.targets))
        exec(compile(ast.Module(body=tree.body[:index],type_ignores=[]),'<tutorial setup>','exec'),scope)
        model,optimizer=scope['model_opt'],scope['optimizer']
